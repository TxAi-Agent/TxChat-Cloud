{
  "name": "txchat-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.admin-web.json",
    "build": "node scripts/clean-build-output.mjs && tsc && node scripts/copy-schema.mjs && node scripts/build-admin-assets.mjs",
    "test": "vitest run",
    "verify": "node scripts/verify-source.mjs && pnpm typecheck && pnpm build && node scripts/verify-licenses.mjs && pnpm test"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.7",
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/openapi-client": "0.4.15",
    "@alicloud/tea-util": "1.4.11",
    "@fastify/jwt": "10.2.1",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/websocket": "11.3.0",
    "better-sqlite3": "13.0.1",
    "fastify": "5.12.5",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tabler/core": "1.4.0",
    "@tabler/icons-webfont": "3.46.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
