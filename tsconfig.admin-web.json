{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "admin-web/src",
    "outDir": "dist/admin/assets/modules",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": ["admin-web/src/**/*.ts"]
}
